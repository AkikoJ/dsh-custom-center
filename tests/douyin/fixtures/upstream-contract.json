  "pluginId": "douyin-life",
  "settingsId": "douyin-life",
  "conversationViewId": "douyin-watched",
  "tools": [
    {
      "name": "dy_status",
      "description": "看它今天的状态：跑了没跑、挑了几条、额度剩多少、报告在哪、登录过没有、家目录、下次窗口什么时候开。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_chrome_open",
      "description": "把「本人已经登录的那个 Chrome」拉起来并开 CDP 调试端口，之后所有抖音动作都走这个浏览器（登录态直接用，不用再扫码）。\n⚠️ Chrome 已经开着的时候，带同一个默认 profile 再拉一次**不会**开调试端口 —— 先全关 Chrome 再调这个。\n默认（cdpUrl 为空）用插件自己的持久 profile，第一次扫码一次；调这个会把 cdpUrl 切成 CDP 模式。",
      "parameters": {
        "type": "object",
        "properties": {
          "port": {
            "type": "number",
            "description": "调试端口（默认用设置里的 cdpPort / 9222）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_config",
      "description": "读 / 改「刷抖音」的设置。不给 `patch` 就是读；给了就改（只认 schema 里的字段）。\n例：`{\"perDay\":5,\"peakValley\":true,\"autoLike\":false,\"autoComment\":false,\"mentionName\":\"\"}`；ComfyUI：`{\"comfyUrl\":\"http://127.0.0.1:8188\",\"comfyOutputDir\":\"<本机 ComfyUI 的 output 目录>\"}`（目录留空表示还没接）。",
      "parameters": {
        "type": "object",
        "properties": {
          "patch": {
            "type": "object",
            "additionalProperties": true,
            "description": "要改的字段（可省）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_whoami",
      "description": "看抖音那边登录的是谁（昵称 / uid、登录态是否有效）。第一次用要先 dy_login_start 扫码。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_login_start",
      "description": "打开登录窗并截下二维码。本人扫完后调 dy_login_poll。\n扫码之后抖音会再弹一层二次验证：上面先是「收验证码」，点开之后才有「获取验证码」。\npoll 返回 need_sms 时调 dy_login_sms，它会按这个顺序点，不会刷新页面、不会重新出码。\n若弹出图形验证，让本人在这个窗口里拖完，不要关窗、不要重新出码。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_login_poll",
      "description": "查扫码结果。state=need_sms 表示扫完弹出了二次验证，接着调 dy_login_sms（先点「收验证码」，再点「获取验证码」），不要重新出码。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_login_sms",
      "description": "扫码后的二次验证。在当前窗口先点「收验证码」，再点「获取验证码」，不会刷新页面。\n弹层里已经带出手机号时 phone 可以不填。号码是空的才要 11 位。\n若返回 needCaptcha，让本人在这个窗口里拖完滑块，不要重新出码。\n短信到了再调 dy_login_sms_submit。只发给本人确认过的号码。",
      "parameters": {
        "type": "object",
        "properties": {
          "phone": {
            "type": "string",
            "description": "本人手机号（11 位）。二次验证弹层里已经有号码时留空。"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_login_sms_submit",
      "description": "短信验证码登录（第二步）：把本人报给你的验证码填进去并点登录，然后等登录态。",
      "parameters": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "短信里的验证码（4~6 位数字）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_reply_round",
      "description": "回我自己视频下的评论（随机挑视频、随机挑评论）。\n每条回复**不超过 20 字**；对方是敏感话题（政治/医疗/法律/隐私/黄赌毒/金融荐股/破解代做等）⇒ 换成委婉拒绝。\n数量由设置里的「每次回几条 / 每天最多回」控制，也可以直接传 count。回过的评论不会重复回。",
      "parameters": {
        "type": "object",
        "properties": {
          "count": {
            "type": "number",
            "description": "这次想回几条（不填就用设置里的「每次回几条」）"
          },
          "random": {
            "type": "boolean",
            "description": "随机挑（默认按设置里的开关）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_chat_send",
      "description": "给某个好友发一条私信。一个原语干三件事：转发视频（正文放视频链接）、续火花（随便一句）、发表情包（用 [憨笑] 这类文本码）。",
      "parameters": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "对方昵称"
          },
          "text": {
            "type": "string",
            "description": "要发的内容（可含 https://www.douyin.com/video/<id> 或 [憨笑] 这类表情码）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_chat_sticker",
      "description": "在私信里发表情包。keyword 传情绪词（开心/委屈/生气/无语/困/可爱/得意/难过），插件按收藏标签挑；留空则随机挑一张（不会永远发同一张）。pick 可指定第几张。",
      "parameters": {
        "type": "object",
        "properties": {
          "nickname": {
            "type": "string",
            "description": "发给谁"
          },
          "keyword": {
            "type": "string",
            "description": "搜什么关键词（默认「大肥鱼」）"
          },
          "pick": {
            "type": "number",
            "description": "挑第几个（从 0 开始，默认 0）"
          },
          "flip": {
            "type": "number",
            "description": "翻几页（0–6）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_reconcile_pending",
      "description": "核对「发送状态待核对」的回复：查回复列表，已经发出去的记为成功，没发的保持失败。用来清掉卡住的 pending。",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "最多核对几条（默认 10）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_dm_inbox",
      "description": "只读：看私信收件箱最近的消息（谁发的、内容预览、是不是视频分享），不发任何东西。",
      "parameters": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "description": "取几条（默认 20）"
          },
          "nickname": {
            "type": "string",
            "description": "只看和某个人的会话（留空=全部，慢）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_watch",
      "description": "真·看视频：下载这条视频 → 抽音轨 → 本地转写成文字，返回 transcript 和时长。看懂了再回话。",
      "parameters": {
        "type": "object",
        "properties": {
          "aweme_id": {
            "type": "string",
            "description": "视频 id 或整条链接"
          },
          "seconds": {
            "type": "number",
            "description": "最多看多少秒（默认 300）"
          },
          "frames": {
            "type": "number",
            "description": "抽多少帧（默认按设置里的 watchFrames）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_dm_poll",
      "description": "手动跑一次私信后台巡检：有新的就起 headless 回一句，没有就什么都不做。用来查「为什么不回私信」。",
      "parameters": {
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_cleanup",
      "description": "手动清一次：临时垃圾、30 天前的缩略图、120 天前的日报、超大日志轮转、浏览器 Cache（不动登录态）。",
      "parameters": {
        "type": "object",
        "properties": {
          "thumbDays": {
            "type": "number",
            "description": "缩略图保留多少天（默认 30）"
          },
          "reportDays": {
            "type": "number",
            "description": "日报保留多少天（默认 120）"
          }
        },
        "additionalProperties": false
      },
      "output": {
        "type": "object",
        "properties": {},
        "additionalProperties": true
      }
    },
    {
      "name": "dy_dm_round",
      "description": "看一遍私信：谁发来新消息就回一句（每人每天「回几条」有限制，总条数也有上限）。陌生人消息也会回。",
      "parameters": {
